#
# ImmortalWrt Configuration for NanoPi M4
# SoC: Rockchip RK3399
# Target: rockchip/armv8
# Branch: openwrt-24.10  -> 官方 6.6.x LTS 内核 (KERNEL_PATCHVER=6.6)
# Boot:  TF 卡 (生成 sysupgrade.img.gz 整卡镜像, 直接写入 TF 卡即可启动)
# Rootfs: 2048 MiB (2G)
#
# 前提: 仓库需包含 patches/001-add-nanopi-m4-device.patch 和
#       patches/002-add-nanopi-m4-uboot.patch, workflow 会先打补丁。
#       官方 ImmortalWrt 不含 M4 设备, 不打补丁时下面这个 DEVICE
#       符号不存在, 会被 make defconfig 静默丢弃。
#

# Target System
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_friendlyarm_nanopi-m4=y

# Target Images
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# 根分区 2G (单位 MiB)。ImmortalWrt 默认仅 160 MiB,
# docker/openclash/iStore 等包会把 ext4 镜像撑爆 (第 6 步报错原因)。
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
# ==========================================
# 根文件系统扩容工具 - 支持eMMC/SD卡空间扩展
# ==========================================
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_losetup=y
CONFIG_PACKAGE_kmod-mmc-block=y
CONFIG_PACKAGE_kmod-block=y

# ==========================================
# Storage Support - eMMC & TF Card
# ==========================================
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_mkdosfs=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_exfat-utils=y
CONFIG_PACKAGE_kmod-fs-exfat=y

# General Configuration
CONFIG_PACKAGE_ipv6=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_btrfs-progs=y

# LuCI Web Interface
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y

# LuCI Theme
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# Kernel Modules - USB
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y

# Kernel Modules - Filesystem
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y

# ==========================================
# 4G/5G Module Support
# ==========================================
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
CONFIG_PACKAGE_kmod-usb-serial-sierrawireless=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-subset=y
CONFIG_PACKAGE_kmod-usb-net-hso=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-rtl8153=y
CONFIG_PACKAGE_kmod-usb-net-cdc_mbim=y
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_usb-modeswitch-data=y

# ==========================================
# Android USB Tethering
# ==========================================
CONFIG_PACKAGE_kmod-nls-base=y

# ==========================================
# Cellular Tools
# ==========================================
CONFIG_PACKAGE_comgt=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_wwan=y
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_luci-proto-ncm=y
CONFIG_PACKAGE_luci-proto-3g=y
CONFIG_PACKAGE_luci-proto-wwan=y

# Network Configuration
# OpenClash requires dnsmasq-full.  Do not select the split dnsmasq-dhcpv6
# package: it provides the same dnsmasq implementation and conflicts with it.
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

# SSH
CONFIG_PACKAGE_openssh-server-default=y

# Firewall
CONFIG_PACKAGE_iptables-nft=y

# ==========================================
# KMS 激活服务 (Windows/Office 激活)
# ==========================================
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y
CONFIG_PACKAGE_vlmcsd=y

# ==========================================
# DDNS 动态域名解析
# ==========================================
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_ddns-scripts-dnspod=y
CONFIG_PACKAGE_ddns-scripts-noip=y
CONFIG_PACKAGE_ddns-scripts-aliyun=y

# ==========================================
# PassWall - Full Support
# ==========================================
# PassWall 主程序
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-i18n-passwall-zh-cn is not set

# 核心依赖 (Core Dependencies)
CONFIG_PACKAGE_ipt2socks=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_kmod-ipt-nat=y

# 代理客户端 (Proxy Clients)
CONFIG_PACKAGE_hysteria2=y
CONFIG_PACKAGE_naiveproxy=y
CONFIG_PACKAGE_shadowsocks-rust-sslocal=y
CONFIG_PACKAGE_shadowsocks-rust-ssserver=y
CONFIG_PACKAGE_simple-obfs-client=y

# 代理插件 (Proxy Plugins)
CONFIG_PACKAGE_v2ray-plugin=y
# CONFIG_PACKAGE_xray-plugin is not set

# DNS 工具
CONFIG_PACKAGE_dns2socks=y
CONFIG_PACKAGE_tcping=y

# ==========================================
# SmartDNS - DNS加速
# ==========================================
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y
CONFIG_PACKAGE_smartdns=y

# ==========================================
# OpenClash Support
# ==========================================
# CONFIG_PACKAGE_luci-app-openclash is not set

# ==========================================
# iStore 应用商店
# ==========================================
CONFIG_PACKAGE_luci-app-store=y

# ==========================================
# Docker Support (增强)
# ==========================================
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_docker-ce=y
CONFIG_PACKAGE_docker-ce-cli=y
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
CONFIG_PACKAGE_tini=y
CONFIG_PACKAGE_cgroupfs-mount=y

# Docker storage driver options
CONFIG_DOCKER_overlay2=y
CONFIG_DOCKER_bridge=y
CONFIG_DOCKER_host=y
CONFIG_DOCKER_ipvlan_macvlan=y
CONFIG_DOCKER_null_overlay=y

# ==========================================
# Other Useful Packages
# ==========================================
CONFIG_PACKAGE_luci-app-ttyd=y
