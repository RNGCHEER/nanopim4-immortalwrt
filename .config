#
# ImmortalWrt Configuration for NanoPi M4
# SoC: Rockchip RK3399
# Target: rockchip/armv8
# Branch: openwrt-24.10  -> 官方 6.6.x LTS 内核 (KERNEL_PATCHVER=6.6)
# Boot:  TF 卡 (生成 sysupgrade.img.gz 整卡镜像, 直接写入 TF 卡即可启动)
# Rootfs: 2048 MiB (2G)
#
# 前提: 仓库需包含 patches/001-add-nanopi-m4-device.patch 和
#       patches/002-add-nanopi-m4-uboot.patch, workflow 会先打补丁。
#       官方 ImmortalWrt 不含 M4 设备, 不打补丁时下面这个 DEVICE
#       符号不存在, 会被 make defconfig 静默丢弃。
#

# Target System
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_friendlyarm_nanopi-m4=y

# Target Images
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# 根分区 2G (单位 MiB)。ImmortalWrt 默认仅 160 MiB,
# docker/openclash/iStore 等包会把 ext4 镜像撑爆 (第 6 步报错原因)。
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# General Configuration
CONFIG_PACKAGE_ipv6=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_openssh-sftp-server=y

# LuCI Web Interface
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y

# LuCI Theme
CONFIG_PACKAGE_luci-theme-bootstrap=y

# Kernel Modules - USB
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y

# Kernel Modules - Filesystem
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y

# Network Configuration
# OpenClash requires dnsmasq-full.  Do not select the split dnsmasq-dhcpv6
# package: it provides the same dnsmasq implementation and conflicts with it.
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

# SSH
CONFIG_PACKAGE_openssh-server-default=y

# Firewall
CONFIG_PACKAGE_iptables-nft=y

# Docker Support
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_docker-ce=y
CONFIG_PACKAGE_docker-ce-cli=y
CONFIG_PACKAGE_containerd=y

# iStore OS Store
CONFIG_PACKAGE_luci-app-store=y

# OpenClash
CONFIG_PACKAGE_luci-app-openclash=y
